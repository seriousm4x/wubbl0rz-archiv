{
	"name": "frontend",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint --fix --cache .",
		"format": "prettier --write --cache --cache-strategy content .",
		"prepare": "cd .. && husky frontend/.husky"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@iconify-icons/fluent": "^2.0.4",
		"@iconify-icons/solar": "^2.0.4",
		"@iconify/svelte": "^5.2.2",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.1",
		"autoprefixer": "^10.6.1",
		"daisyui": "^5.7.47",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.13.0",
		"husky": "^9.1.7",
		"lightningcss": "^1.33.0",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"tslib": "^2.8.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.1",
		"vite": "^8.3.3"
	},
	"type": "module",
	"lint-staged": {
		"*.{js,svelte}": "eslint --fix --cache .",
		"*.{js,css,md,svelte,scss}": "prettier --write --cache --cache-strategy content ."
	},
	"dependencies": {
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@videojs/html": "^10.0.1",
		"date-fns": "^4.4.0",
		"fscreen": "^1.2.0",
		"hls.js": "^1.7.3",
		"meilisearch": "^0.62.0",
		"pocketbase": "^0.28.1"
	}
}
